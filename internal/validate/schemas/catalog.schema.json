{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qllm.dev/schemas/catalog.schema.json",
  "title": "qLLM Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "project", "entities"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "logicalType": {
      "type": "string",
      "enum": ["string", "number", "boolean", "timestamp", "json"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "binding", "fields"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true,
          "description": "Optional alternate names resolvable in IR from/joins"
        },
        "description": { "type": "string" },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "binding": { "$ref": "#/$defs/binding" },
        "primaryKey": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        "scope": { "$ref": "#/$defs/entityScope" }
      }
    },
    "binding": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["table", "collection", "rest_resource", "key", "topic"]
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "collection": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "resource": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "keyPattern": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "accessPath": { "$ref": "#/$defs/accessPath" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "table" } } },
          "then": { "required": ["schema", "table"] }
        },
        {
          "if": { "properties": { "kind": { "const": "collection" } } },
          "then": { "required": ["collection"] }
        },
        {
          "if": { "properties": { "kind": { "const": "rest_resource" } } },
          "then": { "required": ["resource"] }
        },
        {
          "if": { "properties": { "kind": { "const": "key" } } },
          "then": { "required": ["keyPattern"] }
        },
        {
          "if": { "properties": { "kind": { "const": "topic" } } },
          "then": { "required": ["topic"] }
        }
      ]
    },
    "accessPath": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required predicates for dynamodb/cassandra/ksql/redis/kafka. Missing eq on these fields → UNSUPPORTED (no table scan).",
      "properties": {
        "partition": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pk": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sort": { "type": "string", "minLength": 1 },
        "sk": { "type": "string", "minLength": 1 },
        "ksqlKey": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "physical"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": { "$ref": "#/$defs/logicalType" },
        "physical": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "Physical column/key; optional dotted path for nested docs"
        },
        "description": { "type": "string" },
        "fromFilter": {
          "type": "boolean",
          "description": "REST only: fill this field from a top-level AND of eq filters when the API omits it (D20)"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "to", "type", "on"],
      "properties": {
        "name": { "type": "string" },
        "to": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["many_to_one", "one_to_many", "one_to_one"]
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string" }
          }
        }
      }
    },
    "entityScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Scope key name (matches the value carried by the credential)"
        },
        "column": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Logical field to filter when it differs from field (D21)"
        }
      }
    }
  }
}
