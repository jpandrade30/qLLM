{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qllm.dev/schemas/preset.schema.json",
  "title": "qLLM Project Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "project", "limits", "sources"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": { "type": "string", "minLength": 1 },
    "limits": { "$ref": "#/$defs/limits" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSyncMs", "maxSourceMs", "defaultLimit", "maxLimit", "readOnly"],
      "properties": {
        "maxSyncMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "maxSourceMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "defaultLimit": { "type": "integer", "minimum": 1 },
        "maxLimit": { "type": "integer", "minimum": 1 },
        "readOnly": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "connection"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "mongodb",
            "rest",
            "mssql",
            "sqlite",
            "clickhouse",
            "dynamodb",
            "cassandra",
            "ksql",
            "mariadb",
            "tidb",
            "vitess",
            "aurora_mysql",
            "planetscale",
            "cockroach",
            "yugabyte",
            "alloydb",
            "aurora_postgres",
            "neon",
            "supabase",
            "timescale",
            "redshift"
          ]
        },
        "connection": { "type": "object" },
        "options": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["postgres", "cockroach", "yugabyte", "alloydb", "aurora_postgres", "neon", "supabase", "timescale", "redshift", "mysql", "mariadb", "tidb", "vitess", "aurora_mysql", "planetscale"] } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/sqlConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "mssql" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/mssqlConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "clickhouse" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/clickhouseConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "sqlite" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/sqliteConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "mongodb" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/mongoConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "rest" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/restConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "dynamodb" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/dynamoConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "cassandra" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/cassandraConnection" } } }
        },
        {
          "if": { "properties": { "type": { "const": "ksql" } } },
          "then": { "properties": { "connection": { "$ref": "#/$defs/ksqlConnection" } } }
        }
      ]
    },
    "sqlConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostEnv", "port", "database", "userEnv", "passwordEnv"],
      "properties": {
        "hostEnv": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "userEnv": { "type": "string", "minLength": 1 },
        "passwordEnv": { "type": "string", "minLength": 1 },
        "sslMode": {
          "type": "string",
          "enum": ["disable", "require", "verify-ca", "verify-full"]
        }
      }
    },
    "mssqlConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostEnv", "port", "database", "userEnv", "passwordEnv"],
      "properties": {
        "hostEnv": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "userEnv": { "type": "string", "minLength": 1 },
        "passwordEnv": { "type": "string", "minLength": 1 },
        "encrypt": {
          "type": "string",
          "enum": ["true", "false", "disable"]
        }
      }
    },
    "clickhouseConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostEnv", "port", "database", "userEnv", "passwordEnv"],
      "properties": {
        "hostEnv": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "userEnv": { "type": "string", "minLength": 1 },
        "passwordEnv": { "type": "string", "minLength": 1 },
        "secure": { "type": "boolean" }
      }
    },
    "sqliteConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathEnv"],
      "properties": {
        "pathEnv": { "type": "string", "minLength": 1 }
      }
    },
    "mongoConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uriEnv", "database"],
      "properties": {
        "uriEnv": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 }
      }
    },
    "restConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrlEnv"],
      "properties": {
        "baseUrlEnv": { "type": "string", "minLength": 1 },
        "auth": { "$ref": "#/$defs/restAuth" }
      }
    },
    "dynamoConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "endpointEnv": { "type": "string", "minLength": 1 }
      }
    },
    "cassandraConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyspace"],
      "properties": {
        "hostEnv": { "type": "string", "minLength": 1 },
        "hostsEnv": { "type": "string", "minLength": 1 },
        "keyspace": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "userEnv": { "type": "string", "minLength": 1 },
        "passwordEnv": { "type": "string", "minLength": 1 }
      }
    },
    "ksqlConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrlEnv"],
      "properties": {
        "baseUrlEnv": { "type": "string", "minLength": 1 },
        "auth": { "$ref": "#/$defs/restAuth" }
      }
    },
    "restAuth": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "bearer", "header", "basic"]
        },
        "tokenEnv": { "type": "string" },
        "name": { "type": "string" },
        "valueEnv": { "type": "string" },
        "userEnv": { "type": "string" },
        "passwordEnv": { "type": "string" }
      }
    }
  }
}
